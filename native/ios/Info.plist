  <key>NSBluetoothAlwaysUsageDescription</key><string>Connect to your paired Meta glasses and receive their camera frames.</string>
  <key>NSCameraUsageDescription</key><string>Use the iPhone back camera as a clearly marked simulated glasses feed for development without physical glasses.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Connect to the glasses over the local Wi-Fi link.</string>
  <key>NSBonjourServices</key><array><string>_bonjour._tcp</string></array>
</dict></plist>
